dotnet_diagnostic.SA1642.severity = none

# Meziantou / Roslynator / Sonar: enforce thread-safety, async ConfigureAwait (MA0004), and 1-type-per-file (MA0048)
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0004.severity = warning
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0008.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0015.severity = none
dotnet_diagnostic.MA0016.severity = none
dotnet_diagnostic.MA0026.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0047.severity = none
dotnet_diagnostic.MA0048.severity = warning
dotnet_diagnostic.MA0049.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.MA0056.severity = none
dotnet_diagnostic.MA0074.severity = none
dotnet_diagnostic.MA0076.severity = none
dotnet_diagnostic.MA0097.severity = none
dotnet_diagnostic.VSTHRD003.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.RCS1036.severity = none
dotnet_diagnostic.S101.severity = none
dotnet_diagnostic.S107.severity = none
dotnet_diagnostic.S127.severity = none
dotnet_diagnostic.S1450.severity = none
dotnet_diagnostic.S2365.severity = none
dotnet_diagnostic.S3776.severity = none
dotnet_diagnostic.S3881.severity = none
dotnet_diagnostic.S4143.severity = none

# Test & benchmark projects: avoid conflict between Meziantou MA0004 (require ConfigureAwait(false)) and xUnit1030 (forbid ConfigureAwait(false) in tests)
[tests/**/*.cs]
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.xUnit1030.severity = none

