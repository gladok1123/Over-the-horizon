    <ProjectReference Include="../../src/OverHorizon.Physics/OverHorizon.Physics.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Gameplay/OverHorizon.Gameplay.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Networking/OverHorizon.Networking.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Modding/OverHorizon.Modding.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Rendering/OverHorizon.Rendering.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Audio/OverHorizon.Audio.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Server/OverHorizon.Server.csproj" />
    <ProjectReference Include="../../src/OverHorizon.Client/OverHorizon.Client.csproj" />
