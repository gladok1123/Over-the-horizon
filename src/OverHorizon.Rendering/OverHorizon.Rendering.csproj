<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OverHorizon.Rendering</RootNamespace>
    <AssemblyName>OverHorizon.Rendering</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OverHorizon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Silk.NET.Core" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Maths" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
  </ItemGroup>

  <!--
    Shaders are compiled to SPIR-V ahead of time (never during gameplay) by the build-time compiler tool,
    and the finished binaries are embedded as manifest resources the Vulkan backend simply maps into memory.
  -->
  <PropertyGroup>
    <VulkanShaderInputDir>$(MSBuildThisFileDirectory)Shaders/</VulkanShaderInputDir>
    <VulkanShaderOutputDir>$(MSBuildThisFileDirectory)Shaders/Generated/</VulkanShaderOutputDir>
    <VulkanShaderCompilerProject>$(MSBuildThisFileDirectory)../../build/OverHorizon.ShaderCompiler/OverHorizon.ShaderCompiler.csproj</VulkanShaderCompilerProject>
  </PropertyGroup>

  <Target Name="CompileVulkanShaders" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(VulkanShaderCompilerProject)&quot; --configuration $(Configuration) -- &quot;$(VulkanShaderInputDir)&quot; &quot;$(VulkanShaderOutputDir)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(VulkanShaderOutputDir)*.spv">
        <LogicalName>OverHorizon.Rendering.Shaders.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../OverHorizon.Core/OverHorizon.Core.csproj" />
    <ProjectReference Include="../OverHorizon.Shared/OverHorizon.Shared.csproj" />
    <ProjectReference Include="../OverHorizon.World/OverHorizon.World.csproj" />
  </ItemGroup>
</Project>
