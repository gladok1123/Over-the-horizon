<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OverHorizon.Rendering</RootNamespace>
    <AssemblyName>OverHorizon.Rendering</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OverHorizon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Silk.NET.Core" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Maths" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
  </ItemGroup>

  <!--
    Shaders are compiled to SPIR-V ahead of time and shipped as finished binaries: the game only ever maps
    these modules into GPU memory, so no GLSL front end and no shader compiler runs during gameplay.
    build/OverHorizon.ShaderCompiler regenerates them from the GLSL sources on demand.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders/SpirV/*.spv">
      <LogicalName>OverHorizon.Rendering.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OverHorizon.Core/OverHorizon.Core.csproj" />
    <ProjectReference Include="../OverHorizon.Shared/OverHorizon.Shared.csproj" />
    <ProjectReference Include="../OverHorizon.World/OverHorizon.World.csproj" />
  </ItemGroup>
</Project>
