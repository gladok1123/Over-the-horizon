<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OverHorizon.Server</RootNamespace>
    <AssemblyName>OverHorizon.Server</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(EnableAotPublish)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OverHorizon.Core/OverHorizon.Core.csproj" />
    <ProjectReference Include="../OverHorizon.Shared/OverHorizon.Shared.csproj" />
    <ProjectReference Include="../OverHorizon.World/OverHorizon.World.csproj" />
    <ProjectReference Include="../OverHorizon.Physics/OverHorizon.Physics.csproj" />
    <ProjectReference Include="../OverHorizon.Gameplay/OverHorizon.Gameplay.csproj" />
    <ProjectReference Include="../OverHorizon.Networking/OverHorizon.Networking.csproj" />
    <ProjectReference Include="../OverHorizon.Modding/OverHorizon.Modding.csproj" />
  </ItemGroup>
</Project>
